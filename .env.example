# copy to .env and fill in. NEVER commit .env
MLFLOW_TRACKING_URI=https://dagshub.com/<user>/<RollNo_A2_Ops>.mlflow
MLFLOW_TRACKING_USERNAME=<dagshub-username>
MLFLOW_TRACKING_PASSWORD=<dagshub-token>
POSTGRES_USER=visionguard
POSTGRES_PASSWORD=change_me
POSTGRES_DB=visionguard
MODEL_PATH=/models/champion.keras
THRESHOLD=0.5
MODEL_NAME=VisionGuard
MODEL_VERSION=2
# Task 8: cloud API (leave API_URL empty to use the local model)
API_URL=
API_KEY=change_me_api_key
SECRET_KEY=change_me
